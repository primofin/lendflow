# Copy to backend/.env and fill in. Never commit the real file.
DATABASE_URL=postgresql+psycopg://lendflow:lendflow@localhost:5433/lendflow
TEST_DATABASE_URL=postgresql+psycopg://lendflow:lendflow@localhost:5433/lendflow_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
OFFICER_APPROVAL_LIMIT_VND=200000000
# LF-005 uploads: keep this folder outside any web root
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENTS_PER_APPLICATION=20
# LF-008 mock credit-bureau timings (illustrative; the real bureau takes 3 to 7 minutes)
CIC_DURATION_SECONDS=20
CIC_ATTEMPT_TIMEOUT_SECONDS=60
CIC_MAX_ATTEMPTS=2
# LF-017 / BR-11: hours a supervisor may hold a file before it is overdue (illustrative)
SUPERVISOR_SLA_HOURS=24
# LF-013 CSV import limits
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_ROWS=500
AI_MODE=mock
# Deployment (docs/deploy.md): header set by a trusted proxy (Fly-Client-IP); empty when the API is directly reachable
CLIENT_IP_HEADER=
CALCULATOR_RATE_LIMIT_PER_MINUTE=60
# Owner connection for migrations when DATABASE_URL is the restricted app role
# MIGRATION_DATABASE_URL=
